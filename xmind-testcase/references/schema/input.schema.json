{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "XMind 测试用例生成输入",
  "type": "object",
  "additionalProperties": false,
  "anyOf": [
    {"required": ["screenshots"]},
    {"required": ["page_description"]},
    {"required": ["requirements"]},
    {"required": ["flow_description"]}
  ],
  "properties": {
    "screenshots": {
      "type": "array",
      "description": "页面截图列表。多页面流程应按流程顺序排列；若顺序不确定，请填写 page_order。",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["page_name", "image_data"],
        "additionalProperties": false,
        "properties": {
          "page_name": {"type": "string", "minLength": 1},
          "image_data": {"type": "string", "minLength": 1},
          "page_order": {"type": "integer", "minimum": 1},
          "page_role": {
            "type": "string",
            "enum": ["start", "middle", "result", "single"]
          },
          "notes": {"type": "string"}
        }
      }
    },
    "page_description": {"type": "string", "minLength": 1},
    "requirements": {
      "oneOf": [
        {"type": "string", "minLength": 1},
        {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        }
      ]
    },
    "flow_name": {"type": "string", "minLength": 1},
    "flow_description": {"type": "string", "minLength": 1},
    "module_name": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
    },
    "test_mode": {
      "type": "string",
      "enum": ["single_page", "cross_page"]
    },
    "focus_scenarios": {
      "type": "array",
      "items": {"$ref": "#/definitions/scenarioKey"},
      "uniqueItems": true
    },
    "coverage_level": {
      "type": "string",
      "enum": ["minimal", "standard", "full"],
      "default": "standard"
    },
    "language": {"type": "string", "default": "zh-CN"},
    "target_xmind_version": {
      "type": "string",
      "enum": ["modern-json", "legacy-xml", "hybrid"],
      "default": "modern-json"
    },
    "output_path": {
      "type": "string",
      "pattern": "^.*\\.xmind$"
    }
  },
  "definitions": {
    "scenarioKey": {
      "type": "string",
      "enum": [
        "main_flow",
        "interruption",
        "abnormal_navigation",
        "state_consistency",
        "duplicate_submit",
        "basic_function",
        "boundary",
        "invalid_input",
        "field_dependency",
        "stability"
      ]
    }
  }
}
